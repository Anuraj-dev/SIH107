# Copy to .env (never commit .env or real keys)
# BIS_ADMIN_API_KEYS=key1,key2   # admin endpoints, Phase 4
# BIS_SSO_PROVIDER=               # chosen in Phase 4 (else API keys)

# Full-text RAG corpus (scripts/import_rag_corpus.py --corpus <dir> --db kb/bis_rag.db)
# BIS_RAG_ENABLED=1
# BIS_RAG_DB_PATH=kb/bis_rag.db
# BIS_RAG_TOP_K=5
# BIS_RAG_SEMANTIC=1
# BIS_RAG_EMBEDDING_MODEL=
# BIS_RAG_MIN_OVERLAP=3           # corpus relevance token floor
# BIS_RAG_MIN_LEXICAL=15.0        # corpus relevance lexical floor
# BIS_RAG_CATALOGUE_MIN_SCORE=8.0 # pre-clarification catalogue bar
# Grounded generation (empty model = extractive fallback, no LLM call)
# BIS_LLM_PROVIDER=openai-compatible  # openai-compatible | gemini | ollama
# BIS_LLM_MODEL=                      # gpt-4o-mini | gemini-2.0-flash | llama3 ...
# BIS_LLM_API_KEY=                    # not needed for local ollama
# BIS_LLM_BASE_URL=https://api.openai.com/v1  # ollama default http://localhost:11434
# BIS_LLM_RETRIES=0
# BIS_LLM_TIMEOUT_S=10
# BIS_LLM_CACHE_TTL=300           # reuse identical grounded answers (s); 0 disables
# 24k catalogue fallback, independent of rag.enabled (issue #4 P0-1)
# BIS_CATALOGUE_ENABLED=1
# BIS_RAG_CATALOGUE=1             # legacy alias, honored until removed
# BIS_GUIDANCE_ADAPTIVE=1
# Retrieval floors (issue #4 P0-2)
# BIS_RETRIEVAL_GROUNDED_SCORE=10
# BIS_RETRIEVAL_FUSION_STRONG_SCORE=15
# Memory expansion caps (issue #4 P0-6)
# BIS_MEMORY_EXPAND_TURNS=2
# BIS_MEMORY_EXPAND_TERMS=6
# BIS_MEMORY_EXPAND_CHARS=200
