# Copy to .env. Keep real API keys out of Git.

# BIS corpus retrieval
# BIS_RAG_ENABLED=1
# BIS_RAG_DB_PATH=kb/bis_rag.db
# BIS_RAG_TOP_K=5
# BIS_RAG_SEMANTIC=1
# BIS_RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# BIS_RAG_RERANKER_MODEL=BAAI/bge-reranker-base
# BIS_RAG_MIN_OVERLAP=3
# BIS_RAG_MIN_LEXICAL=15.0
# BIS_GUIDANCE_ADAPTIVE=1
# BIS_RETRIEVAL_GROUNDED_SCORE=10
# BIS_RETRIEVAL_FUSION_STRONG_SCORE=15
# BIS_MEMORY_EXPAND_TURNS=2
# BIS_MEMORY_EXPAND_TERMS=6
# BIS_MEMORY_EXPAND_CHARS=200

# BIS_ADMIN_API_KEYS=key1,key2 # admin endpoints
# BIS_SSO_PROVIDER=            # configured identity provider, if enabled

# Choose one LLM provider. Without a working model, chat shows an offline notice.

# Local: Ollama
# BIS_LLM_PROVIDER=ollama
# BIS_LLM_MODEL=qwen2.5:7b
# BIS_LLM_BASE_URL=http://localhost:11434
# BIS_LLM_TIMEOUT_S=120

# Local: LM Studio or another OpenAI-compatible server
# BIS_LLM_PROVIDER=openai-compatible
# BIS_LLM_MODEL=<model-id-from-local-server>
# BIS_LLM_BASE_URL=http://localhost:1234/v1
# BIS_LLM_API_KEY=                 # optional for localhost
# BIS_LLM_TIMEOUT_S=120

# Cloud: OpenAI-compatible API, including OpenAI and Groq
# BIS_LLM_PROVIDER=openai-compatible
# BIS_LLM_MODEL=gpt-4o-mini
# BIS_LLM_BASE_URL=https://api.openai.com/v1
# BIS_LLM_API_KEY=<provider-api-key>

# Cloud: Groq Qwen 3.8 27B
# BIS_LLM_PROVIDER=openai-compatible
# BIS_LLM_MODEL=qwen/qwen3.8-27b
# BIS_LLM_BASE_URL=https://api.groq.com/openai/v1
# BIS_LLM_API_KEY=<groq-api-key>

# Cloud: Anthropic
# BIS_LLM_PROVIDER=anthropic
# BIS_LLM_MODEL=<anthropic-model-id>
# BIS_LLM_API_KEY=<anthropic-api-key>

# Cloud: Gemini
# BIS_LLM_PROVIDER=gemini
# BIS_LLM_MODEL=gemini-2.0-flash
# BIS_LLM_API_KEY=<google-api-key>

# Shared generation settings
# BIS_LLM_TEMPERATURE=0.2
# BIS_LLM_MAX_TOKENS=768
# BIS_LLM_RETRIES=1
